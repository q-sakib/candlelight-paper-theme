  "tokenColors": [
    {
      "name": "Comments — doc",
      "scope": "comment.block.documentation",
      "settings": { "foreground": "#907868", "fontStyle": "italic" }
    },
    {
      "name": "Comments",
      "scope": "comment",
      "settings": { "foreground": "#7A6858", "fontStyle": "italic" }
    },
    {
      "name": "Keywords",
      "scope": "keyword",
      "settings": { "foreground": "#A03020", "fontStyle": "bold" }
    },
    {
      "name": "Control flow",
      "scope": "keyword.control",
      "settings": { "foreground": "#902810", "fontStyle": "bold" }
    },
    {
      "name": "Import / Export",
      "scope": ["keyword.control.import", "keyword.control.export"],
      "settings": { "foreground": "#8A5020" }
    },
    {
      "name": "Storage type",
      "scope": "storage.type",
      "settings": { "foreground": "#8A5020" }
    },
    {
      "name": "Storage modifier",
      "scope": "storage.modifier",
      "settings": { "foreground": "#8A5020", "fontStyle": "italic" }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": { "foreground": "#5A5048" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other.readwrite"],
      "settings": { "foreground": "#1A1410" }
    },
    {
      "name": "Constants",
      "scope": "variable.other.constant",
      "settings": { "foreground": "#8A6808" }
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter",
      "settings": { "foreground": "#3A5060" }
    },
    {
      "name": "this / self",
      "scope": "variable.language",
      "settings": { "foreground": "#8A5020", "fontStyle": "italic" }
    },
    {
      "name": "Function definitions",
      "scope": "entity.name.function",
      "settings": { "foreground": "#1A8090" }
    },
    {
      "name": "Function calls",
      "scope": "meta.function-call",
      "settings": { "foreground": "#1A8090" }
    },
    {
      "name": "Arrow =>",
      "scope": "storage.type.function.arrow",
      "settings": { "foreground": "#1A8090" }
    },
    {
      "name": "Built-in functions",
      "scope": "support.function",
      "settings": { "foreground": "#1A8090" }
    },
    {
      "name": "Classes",
      "scope": ["entity.name.type.class", "support.class"],
      "settings": { "foreground": "#804830" }
    },
    {
      "name": "Interfaces / Types",
      "scope": ["entity.name.type.interface", "support.type", "entity.name.type.alias"],
      "settings": { "foreground": "#1A5878" }
    },
    {
      "name": "Generics",
      "scope": "entity.name.type.parameter",
      "settings": { "foreground": "#1A5878", "fontStyle": "italic" }
    },
    {
      "name": "Enums",
      "scope": "entity.name.type.enum",
      "settings": { "foreground": "#804830" }
    },
    {
      "name": "Enum members",
      "scope": "variable.other.enummember",
      "settings": { "foreground": "#8A6808" }
    },
    {
      "name": "Decorators",
      "scope": ["meta.decorator", "entity.name.function.decorator"],
      "settings": { "foreground": "#6840A8", "fontStyle": "bold" }
    },
    {
      "name": "Namespace",
      "scope": "entity.name.type.namespace",
      "settings": { "foreground": "#5A5048" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "meta.object-literal.key"],
      "settings": { "foreground": "#1A4878" }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": { "foreground": "#4A7828" }
    },
    {
      "name": "Template interpolation",
      "scope": ["meta.template.expression", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#1A8090" }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "settings": { "foreground": "#8A6808" }
    },
    {
      "name": "Booleans / null",
      "scope": "constant.language",
      "settings": { "foreground": "#7A6010" }
    },
    {
      "name": "Regex",
      "scope": "string.regexp",
      "settings": { "foreground": "#7A6010" }
    },
    {
      "name": "HTML / JSX tags",
      "scope": ["entity.name.tag", "entity.name.tag.html"],
      "settings": { "foreground": "#A03020" }
    },
    {
      "name": "HTML attributes",
      "scope": "entity.other.attribute-name",
      "settings": { "foreground": "#1A8090" }
    },
    {
      "name": "CSS property names",
      "scope": "support.type.property-name.css",
      "settings": { "foreground": "#1A4878" }
    },
    {
      "name": "Markdown headings",
      "scope": "markup.heading",
      "settings": { "foreground": "#1A5878", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "settings": { "foreground": "#1A1410", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "settings": { "foreground": "#3A5060", "fontStyle": "italic" }
    },
    {
      "name": "Markdown inline code",
      "scope": "markup.raw.inline",
      "settings": { "foreground": "#8A6808" }
    },
    {
      "name": "SQL keywords",
      "scope": "keyword.other.sql",
      "settings": { "foreground": "#A03020", "fontStyle": "bold" }
    }
  ],
  "semanticTokenColors": {
    "variable": "#1A1410",
    "variable.constant": "#8A6808",
    "variable.defaultLibrary": "#1A5878",
    "parameter": "#3A5060",
    "property": "#1A4878",
    "function": "#1A8090",
    "method": "#1A8090",
    "class": "#804830",
    "interface": "#1A5878",
    "enum": "#804830",
    "enumMember": "#8A6808",
    "type": "#1A5878",
    "namespace": "#5A5048",
    "decorator": "#6840A8",
    "string": "#4A7828",
    "number": "#8A6808",
    "keyword": "#A03020",
    "operator": "#5A5048"
  }
}
