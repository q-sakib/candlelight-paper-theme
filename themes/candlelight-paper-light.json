    "editorLineNumber.foreground": "#A4C3B2",
    "editorCursor.foreground": "#EB5E28",
    "editor.selectionBackground": "#F4E28560",
    "editor.inactiveSelectionBackground": "#F4E28530",
    "editor.lineHighlightBackground": "#F5CB5C33",
    "editorIndentGuide.background": "#E8DAB5",
    "editorIndentGuide.activeBackground": "#F4A259",
    "editorBracketMatch.background": "#BC4B5133",
    "editorBracketMatch.border": "#BC4B51",
    "activityBar.background": "#274C77",
    "activityBar.foreground": "#F4E285",
    "activityBarBadge.background": "#F4A259",
    "activityBarBadge.foreground": "#FAF3E0",
    "sideBar.background": "#FFF8E1",
    "sideBar.foreground": "#403D39",
    "sideBarSectionHeader.background": "#A3CEF1",
    "statusBar.background": "#6096BA",
    "statusBar.foreground": "#FAF3E0",
    "statusBar.debuggingBackground": "#BC4B51",
    "titleBar.activeBackground": "#F5CB5C",
    "titleBar.inactiveBackground": "#F4E285",
    "titleBar.activeForeground": "#2D2A26",
    "titleBar.inactiveForeground": "#6B9080",
    "tab.activeBackground": "#F5CB5C",
    "tab.inactiveBackground": "#F4E285",
    "tab.activeForeground": "#403D39",
    "tab.inactiveForeground": "#6B9080",
    "tab.border": "#FAF3E0",
    "panel.background": "#FFF8E1",
    "panel.border": "#E6D9C0",
    "terminal.background": "#FAF3E0",
    "terminal.foreground": "#403D39",
    "focusBorder": "#5B8E7D",
    "widget.shadow": "#C0A88266",
    "list.activeSelectionBackground": "#F5CB5C99",
    "list.activeSelectionForeground": "#2D2A26",
    "list.inactiveSelectionBackground": "#F4E28566",
    "list.inactiveSelectionForeground": "#403D39",
    "list.hoverBackground": "#F4E28599",
    "list.hoverForeground": "#2D2A26",
    "list.focusBackground": "#F5CB5C99",
    "list.focusForeground": "#2D2A26",
    "list.highlightForeground": "#5B8E7D",
    "quickInput.background": "#FFF8E1",
    "quickInput.foreground": "#2D2A26",
    "quickInputList.focusBackground": "#F5CB5C99",
    "quickInputList.focusForeground": "#2D2A26",
    "menu.background": "#FFF8E1",
    "menu.foreground": "#2D2A26",
    "menu.selectionBackground": "#F5CB5C99",
    "menu.selectionForeground": "#2D2A26",
    "menu.separatorBackground": "#E8DAB5",
    "menu.border": "#E8DAB5",
    "dropdown.background": "#FFF8E1",
    "dropdown.border": "#E8DAB5",
    "dropdown.foreground": "#2D2A26",
    "input.placeholderForeground": "#6B908088",
    "button.hoverBackground": "#346B5A",
    "scrollbarSlider.activeBackground": "#5B8E7D66",
    "editorWidget.background": "#FFF8E1",
    "editorWidget.foreground": "#2D2A26",
    "editorWidget.border": "#E8DAB5",
    "editorSuggestWidget.background": "#FFF8E1",
    "editorSuggestWidget.border": "#E8DAB5",
    "editorSuggestWidget.foreground": "#2D2A26",
    "editorSuggestWidget.highlightForeground": "#5B8E7D",
    "editorSuggestWidget.selectedBackground": "#F5CB5C99",
    "editorSuggestWidget.selectedForeground": "#2D2A26",
    "editorHoverWidget.background": "#FFF8E1",
    "editorHoverWidget.foreground": "#2D2A26",
    "editorHoverWidget.border": "#E8DAB5",
    "notifications.background": "#FFF8E1",
    "notifications.foreground": "#2D2A26",
    "notifications.border": "#E8DAB5",
    "notificationsErrorIcon.foreground": "#BC4B51",
    "notificationsWarningIcon.foreground": "#C08A10",
    "notificationsInfoIcon.foreground": "#2A6496",
    "peekView.border": "#5B8E7D",
    "peekViewEditor.background": "#FAF3E0",
    "peekViewResult.background": "#FFF8E1",
    "peekViewResult.selectionBackground": "#F5CB5C99",
    "peekViewResult.selectionForeground": "#2D2A26",
    "peekViewTitle.background": "#F4E285",
    "peekViewTitleLabel.foreground": "#2D2A26",
    "peekViewTitleDescription.foreground": "#6B9080",
    "diffEditor.insertedTextBackground": "#8CB36920",
    "diffEditor.removedTextBackground": "#BC4B5120",
    "gitDecoration.addedResourceForeground": "#5A7A35",
    "gitDecoration.modifiedResourceForeground": "#C08A10",
    "gitDecoration.deletedResourceForeground": "#BC4B51",
    "gitDecoration.untrackedResourceForeground": "#5A7A6E"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": "comment",
      "settings": {
        "foreground": "#6B9080",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": "keyword",
      "settings": {
        "foreground": "#BC4B51",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control Keywords",
      "scope": [
        "keyword.control",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#EB5E28",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": {
        "foreground": "#8CB369"
      }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#EE6055"
      }
    },
    {
      "name": "Booleans & Constants",
      "scope": "constant.language",
      "settings": {
        "foreground": "#F5CB5C"
      }
    },
    {
      "name": "Variables",
      "scope": "variable",
      "settings": {
        "foreground": "#403D39"
      }
    },
    {
      "name": "Function Names",
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#5B8E7D"
      }
    },
    {
      "name": "Function Calls",
      "scope": "meta.function-call",
      "settings": {
        "foreground": "#5B8E7D"
      }
    },
    {
      "name": "Arrow Functions",
      "scope": "storage.type.function.arrow",
      "settings": {
        "foreground": "#1DD3B0"
      }
    },
    {
      "name": "Callback Arguments",
      "scope": "meta.function-call.arguments",
      "settings": {
        "foreground": "#086375"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.type.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#F4A259"
      }
    },
    {
      "name": "Interfaces & Types",
      "scope": [
        "entity.name.type.interface",
        "support.type"
      ],
      "settings": {
        "foreground": "#F5CB5C"
      }
    },
    {
      "name": "Type Parameters",
      "scope": "entity.name.type.parameter",
      "settings": {
        "foreground": "#A3CEF1"
      }
    },
    {
      "name": "Objects & Structs",
      "scope": "meta.object-literal.key",
      "settings": {
        "foreground": "#B2967D"
      }
    },
    {
      "name": "Properties",
      "scope": "variable.other.property",
      "settings": {
        "foreground": "#6096BA"
      }
    },
    {
      "name": "Arrays",
      "scope": "meta.array",
      "settings": {
        "foreground": "#A4C3B2"
      }
    },
    {
      "name": "This Keyword",
      "scope": "variable.language.this",
      "settings": {
        "foreground": "#A3CEF1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tags (HTML/XML)",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#BC4B51"
      }
    },
    {
      "name": "Attribute Names (HTML/XML)",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#5B8E7D"
      }
    },
    {
      "name": "Import/Export Statements",
      "scope": "keyword.control.import, keyword.control.export",
      "settings": {
        "foreground": "#EB5E28"
      }
    }
  ]
}