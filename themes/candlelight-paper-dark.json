  "tokenColors": [
    {
      "name": "Comments",
      "scope": "comment",
      "settings": {
        "foreground": "#6B9080",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": "keyword",
      "settings": {
        "foreground": "#EE6055",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control Keywords",
      "scope": [
        "keyword.control",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#EB5E28",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": {
        "foreground": "#8CB369"
      }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#F5CB5C"
      }
    },
    {
      "name": "Booleans and Language Constants",
      "scope": "constant.language",
      "settings": {
        "foreground": "#F4A259"
      }
    },
    {
      "name": "Variables",
      "scope": "variable",
      "settings": {
        "foreground": "#F4E285"
      }
    },
    {
      "name": "Function Names",
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#5B8E7D"
      }
    },
    {
      "name": "Function Calls",
      "scope": "meta.function-call",
      "settings": {
        "foreground": "#5B8E7D"
      }
    },
    {
      "name": "Arrow Functions",
      "scope": "storage.type.function.arrow",
      "settings": {
        "foreground": "#1DD3B0"
      }
    },
    {
      "name": "Callback Arguments",
      "scope": "meta.function-call.arguments",
      "settings": {
        "foreground": "#086375"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.type.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#EB5E28"
      }
    },
    {
      "name": "Interfaces & Types",
      "scope": [
        "entity.name.type.interface",
        "support.type"
      ],
      "settings": {
        "foreground": "#A3CEF1"
      }
    },
    {
      "name": "Type Parameters",
      "scope": "entity.name.type.parameter",
      "settings": {
        "foreground": "#F5CB5C"
      }
    },
    {
      "name": "Objects",
      "scope": "meta.object-literal.key",
      "settings": {
        "foreground": "#B2967D"
      }
    },
    {
      "name": "Properties",
      "scope": "variable.other.property",
      "settings": {
        "foreground": "#6096BA"
      }
    },
    {
      "name": "Arrays",
      "scope": "meta.array",
      "settings": {
        "foreground": "#A4C3B2"
      }
    },
    {
      "name": "This Keyword",
      "scope": "variable.language.this",
      "settings": {
        "foreground": "#F4A259",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tags (HTML/XML)",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#EE6055"
      }
    },
    {
      "name": "Attribute Names (HTML/XML)",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#5B8E7D"
      }
    },
    {
      "name": "Import/Export Statements",
      "scope": "keyword.control.import, keyword.control.export",
      "settings": {
        "foreground": "#EB5E28"
      }
    }
  ]
}