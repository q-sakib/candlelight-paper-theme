{
  "name": "Candlelight Paper Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#2E2A26",
    "editor.foreground": "#E7DACB",
    "editorLineNumber.foreground": "#A07D5E",
    "editorCursor.foreground": "#FFD28C",
    "editor.lineHighlightBackground": "#3A322C",
    "editor.selectionBackground": "#FFD28C40",
    "editor.inactiveSelectionBackground": "#FFD28C20",
    "editorIndentGuide.background": "#3E3731",
    "editorIndentGuide.activeBackground": "#6B4F3B",
    "editorBracketMatch.background": "#3F2F24",
    "editorBracketMatch.border": "#B08C66",
    "tab.activeBackground": "#40362F",
    "tab.inactiveBackground": "#2E2A26",
    "tab.activeForeground": "#FFD8A0",
    "tab.inactiveForeground": "#A08B78",
    "tab.border": "#4A3E34",
    "activityBar.background": "#3B2F27",
    "activityBar.foreground": "#FFD8A0",
    "activityBarBadge.background": "#B45F06",
    "activityBarBadge.foreground": "#FAF3E0",
    "sideBar.background": "#2A2520",
    "sideBar.foreground": "#E6D7C4",
    "sideBarSectionHeader.background": "#3C3228",
    "statusBar.background": "#3A2F28",
    "statusBar.foreground": "#FFD28C",
    "statusBar.debuggingBackground": "#6A4A32",
    "titleBar.activeBackground": "#392F28",
    "titleBar.inactiveBackground": "#302820",
    "titleBar.activeForeground": "#FFD8A0",
    "titleBar.inactiveForeground": "#A08B78",
    "panel.background": "#2E2822",
    "panel.border": "#4A3E34",
    "terminal.background": "#2E2A26",
    "terminal.foreground": "#E7DACB"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#9A8C7A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#FFAD60",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#E6B870"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#C69A6E"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#E2D3C0"
      }
    },
    {
      "scope": "support.function, entity.name.function",
      "settings": {
        "foreground": "#D1BFA3"
      }
    },
    {
      "scope": "meta.array",
      "settings": {
        "foreground": "#E8C798"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#CE9F76"
      }
    }
  ]
}