  "tokenColors": [
    {
      "name": "Comments — doc",
      "scope": "comment.block.documentation",
      "settings": { "foreground": "#9A8050", "fontStyle": "italic" }
    },
    {
      "name": "Comments",
      "scope": "comment",
      "settings": { "foreground": "#7A6838", "fontStyle": "italic" }
    },
    {
      "name": "Keywords",
      "scope": "keyword",
      "settings": { "foreground": "#E85030", "fontStyle": "bold" }
    },
    {
      "name": "Control flow",
      "scope": "keyword.control",
      "settings": { "foreground": "#D84020", "fontStyle": "bold" }
    },
    {
      "name": "Import / Export",
      "scope": ["keyword.control.import", "keyword.control.export"],
      "settings": { "foreground": "#D08030" }
    },
    {
      "name": "Storage type",
      "scope": "storage.type",
      "settings": { "foreground": "#D08030" }
    },
    {
      "name": "Storage modifier",
      "scope": "storage.modifier",
      "settings": { "foreground": "#D08030", "fontStyle": "italic" }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": { "foreground": "#B09060" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other.readwrite"],
      "settings": { "foreground": "#EAD8A8" }
    },
    {
      "name": "Constants",
      "scope": "variable.other.constant",
      "settings": { "foreground": "#D8A030" }
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter",
      "settings": { "foreground": "#C8B880" }
    },
    {
      "name": "this / self",
      "scope": "variable.language",
      "settings": { "foreground": "#D08030", "fontStyle": "italic" }
    },
    {
      "name": "Function definitions",
      "scope": "entity.name.function",
      "settings": { "foreground": "#38A880" }
    },
    {
      "name": "Function calls",
      "scope": "meta.function-call",
      "settings": { "foreground": "#38A880" }
    },
    {
      "name": "Arrow =>",
      "scope": "storage.type.function.arrow",
      "settings": { "foreground": "#18D8C0" }
    },
    {
      "name": "Built-in functions",
      "scope": "support.function",
      "settings": { "foreground": "#38A880" }
    },
    {
      "name": "Classes",
      "scope": ["entity.name.type.class", "support.class"],
      "settings": { "foreground": "#D07838" }
    },
    {
      "name": "Interfaces / Types",
      "scope": ["entity.name.type.interface", "support.type", "entity.name.type.alias"],
      "settings": { "foreground": "#70A8D0" }
    },
    {
      "name": "Generics",
      "scope": "entity.name.type.parameter",
      "settings": { "foreground": "#70A8D0", "fontStyle": "italic" }
    },
    {
      "name": "Enums",
      "scope": "entity.name.type.enum",
      "settings": { "foreground": "#D07838" }
    },
    {
      "name": "Enum members",
      "scope": "variable.other.enummember",
      "settings": { "foreground": "#D8A030" }
    },
    {
      "name": "Decorators",
      "scope": ["meta.decorator", "entity.name.function.decorator"],
      "settings": { "foreground": "#A058C8", "fontStyle": "bold" }
    },
    {
      "name": "Namespace",
      "scope": "entity.name.type.namespace",
      "settings": { "foreground": "#9A8858" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "meta.object-literal.key"],
      "settings": { "foreground": "#5090B8" }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": { "foreground": "#88B040" }
    },
    {
      "name": "Template interpolation",
      "scope": ["meta.template.expression", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#18D8C0" }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "settings": { "foreground": "#D8A030" }
    },
    {
      "name": "Booleans / null",
      "scope": "constant.language",
      "settings": { "foreground": "#C88828" }
    },
    {
      "name": "Regex",
      "scope": "string.regexp",
      "settings": { "foreground": "#C88828" }
    },
    {
      "name": "HTML / JSX tags",
      "scope": ["entity.name.tag", "entity.name.tag.html"],
      "settings": { "foreground": "#E85030" }
    },
    {
      "name": "HTML attributes",
      "scope": "entity.other.attribute-name",
      "settings": { "foreground": "#38A880" }
    },
    {
      "name": "CSS property names",
      "scope": "support.type.property-name.css",
      "settings": { "foreground": "#5090B8" }
    },
    {
      "name": "Markdown headings",
      "scope": "markup.heading",
      "settings": { "foreground": "#70A8D0", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "settings": { "foreground": "#EAD8A8", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "settings": { "foreground": "#C8B880", "fontStyle": "italic" }
    },
    {
      "name": "Markdown inline code",
      "scope": "markup.raw.inline",
      "settings": { "foreground": "#D8A030" }
    },
    {
      "name": "Markdown link",
      "scope": "string.other.link.title.markdown",
      "settings": { "foreground": "#5090B8" }
    },
    {
      "name": "SQL keywords",
      "scope": "keyword.other.sql",
      "settings": { "foreground": "#E85030", "fontStyle": "bold" }
    }
  ],
  "semanticTokenColors": {
    "variable": "#EAD8A8",
    "variable.constant": "#D8A030",
    "variable.defaultLibrary": "#70A8D0",
    "parameter": "#C8B880",
    "property": "#5090B8",
    "function": "#38A880",
    "method": "#38A880",
    "class": "#D07838",
    "interface": "#70A8D0",
    "enum": "#D07838",
    "enumMember": "#D8A030",
    "type": "#70A8D0",
    "namespace": "#9A8858",
    "decorator": "#A058C8",
    "string": "#88B040",
    "number": "#D8A030",
    "keyword": "#E85030",
    "operator": "#B09060",
    "regexp": "#C88828"
  }
}
