  "tokenColors": [
    {
      "name": "Comments — doc",
      "scope": "comment.block.documentation",
      "settings": { "foreground": "#4A9060", "fontStyle": "italic" }
    },
    {
      "name": "Comments",
      "scope": "comment",
      "settings": { "foreground": "#3A7848", "fontStyle": "italic" }
    },
    {
      "name": "Keywords",
      "scope": "keyword",
      "settings": { "foreground": "#D05870", "fontStyle": "bold" }
    },
    {
      "name": "Control flow",
      "scope": "keyword.control",
      "settings": { "foreground": "#C04860", "fontStyle": "bold" }
    },
    {
      "name": "Import / Export",
      "scope": ["keyword.control.import", "keyword.control.export"],
      "settings": { "foreground": "#D07840" }
    },
    {
      "name": "Storage type",
      "scope": "storage.type",
      "settings": { "foreground": "#D07840" }
    },
    {
      "name": "Storage modifier",
      "scope": "storage.modifier",
      "settings": { "foreground": "#D07840", "fontStyle": "italic" }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": { "foreground": "#70A078" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other.readwrite"],
      "settings": { "foreground": "#BEDBAE" }
    },
    {
      "name": "Constants",
      "scope": "variable.other.constant",
      "settings": { "foreground": "#E8B838" }
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter",
      "settings": { "foreground": "#98C888" }
    },
    {
      "name": "this / self",
      "scope": "variable.language",
      "settings": { "foreground": "#D07840", "fontStyle": "italic" }
    },
    {
      "name": "Function definitions",
      "scope": "entity.name.function",
      "settings": { "foreground": "#3AAA60" }
    },
    {
      "name": "Function calls",
      "scope": "meta.function-call",
      "settings": { "foreground": "#3AAA60" }
    },
    {
      "name": "Arrow =>",
      "scope": "storage.type.function.arrow",
      "settings": { "foreground": "#10D890" }
    },
    {
      "name": "Built-in functions",
      "scope": "support.function",
      "settings": { "foreground": "#3AAA60" }
    },
    {
      "name": "Classes",
      "scope": ["entity.name.type.class", "support.class"],
      "settings": { "foreground": "#C07838" }
    },
    {
      "name": "Interfaces / Types",
      "scope": ["entity.name.type.interface", "support.type", "entity.name.type.alias"],
      "settings": { "foreground": "#70B8CC" }
    },
    {
      "name": "Generics",
      "scope": "entity.name.type.parameter",
      "settings": { "foreground": "#70B8CC", "fontStyle": "italic" }
    },
    {
      "name": "Enums",
      "scope": "entity.name.type.enum",
      "settings": { "foreground": "#C07838" }
    },
    {
      "name": "Enum members",
      "scope": "variable.other.enummember",
      "settings": { "foreground": "#E8B838" }
    },
    {
      "name": "Decorators",
      "scope": ["meta.decorator", "entity.name.function.decorator"],
      "settings": { "foreground": "#E058A0", "fontStyle": "bold" }
    },
    {
      "name": "Namespace",
      "scope": "entity.name.type.namespace",
      "settings": { "foreground": "#608858" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "meta.object-literal.key"],
      "settings": { "foreground": "#48A888" }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": { "foreground": "#80CC58" }
    },
    {
      "name": "Template interpolation",
      "scope": ["meta.template.expression", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#10D890" }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "settings": { "foreground": "#E8B838" }
    },
    {
      "name": "Booleans / null",
      "scope": "constant.language",
      "settings": { "foreground": "#C89030" }
    },
    {
      "name": "Regex",
      "scope": "string.regexp",
      "settings": { "foreground": "#C89030" }
    },
    {
      "name": "HTML / JSX tags",
      "scope": ["entity.name.tag", "entity.name.tag.html"],
      "settings": { "foreground": "#D05870" }
    },
    {
      "name": "HTML attributes",
      "scope": "entity.other.attribute-name",
      "settings": { "foreground": "#3AAA60" }
    },
    {
      "name": "CSS property names",
      "scope": "support.type.property-name.css",
      "settings": { "foreground": "#48A888" }
    },
    {
      "name": "Markdown headings",
      "scope": "markup.heading",
      "settings": { "foreground": "#70B8CC", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "settings": { "foreground": "#BEDBAE", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "settings": { "foreground": "#98C888", "fontStyle": "italic" }
    },
    {
      "name": "Markdown inline code",
      "scope": "markup.raw.inline",
      "settings": { "foreground": "#E8B838" }
    },
    {
      "name": "Markdown link",
      "scope": "string.other.link.title.markdown",
      "settings": { "foreground": "#48A888" }
    },
    {
      "name": "SQL keywords",
      "scope": "keyword.other.sql",
      "settings": { "foreground": "#D05870", "fontStyle": "bold" }
    }
  ],
  "semanticTokenColors": {
    "variable": "#BEDBAE",
    "variable.constant": "#E8B838",
    "variable.defaultLibrary": "#70B8CC",
    "parameter": "#98C888",
    "property": "#48A888",
    "function": "#3AAA60",
    "method": "#3AAA60",
    "class": "#C07838",
    "interface": "#70B8CC",
    "enum": "#C07838",
    "enumMember": "#E8B838",
    "type": "#70B8CC",
    "namespace": "#608858",
    "decorator": "#E058A0",
    "string": "#80CC58",
    "number": "#E8B838",
    "keyword": "#D05870",
    "operator": "#70A078",
    "regexp": "#C89030"
  }
}
