  "tokenColors": [
    {
      "name": "Comments — block doc",
      "scope": "comment.block.documentation",
      "settings": { "foreground": "#4A9AAA", "fontStyle": "italic" }
    },
    {
      "name": "Comments — block",
      "scope": "comment.block",
      "settings": { "foreground": "#3A7A8A", "fontStyle": "italic" }
    },
    {
      "name": "Comments — line",
      "scope": "comment.line",
      "settings": { "foreground": "#3A7A8A", "fontStyle": "italic" }
    },
    {
      "name": "Comments — fallback",
      "scope": "comment",
      "settings": { "foreground": "#3A7A8A", "fontStyle": "italic" }
    },
    {
      "name": "Keywords",
      "scope": "keyword",
      "settings": { "foreground": "#E06C7A", "fontStyle": "bold" }
    },
    {
      "name": "Control flow",
      "scope": "keyword.control",
      "settings": { "foreground": "#D4556A", "fontStyle": "bold" }
    },
    {
      "name": "Import / Export",
      "scope": ["keyword.control.import", "keyword.control.export"],
      "settings": { "foreground": "#E87E40" }
    },
    {
      "name": "Storage type",
      "scope": "storage.type",
      "settings": { "foreground": "#E87E40" }
    },
    {
      "name": "Storage modifier",
      "scope": "storage.modifier",
      "settings": { "foreground": "#E87E40", "fontStyle": "italic" }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": { "foreground": "#8AB0CC" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other.readwrite"],
      "settings": { "foreground": "#C4DFF0" }
    },
    {
      "name": "Constants (const)",
      "scope": "variable.other.constant",
      "settings": { "foreground": "#F0C040" }
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter",
      "settings": { "foreground": "#90C4DC" }
    },
    {
      "name": "this / self",
      "scope": "variable.language",
      "settings": { "foreground": "#E87E40", "fontStyle": "italic" }
    },
    {
      "name": "Function definitions",
      "scope": "entity.name.function",
      "settings": { "foreground": "#29B6A8" }
    },
    {
      "name": "Function calls",
      "scope": "meta.function-call",
      "settings": { "foreground": "#29B6A8" }
    },
    {
      "name": "Arrow =>",
      "scope": "storage.type.function.arrow",
      "settings": { "foreground": "#00D8C0" }
    },
    {
      "name": "Built-in functions",
      "scope": "support.function",
      "settings": { "foreground": "#29B6A8" }
    },
    {
      "name": "Classes",
      "scope": ["entity.name.type.class", "support.class"],
      "settings": { "foreground": "#E8834A" }
    },
    {
      "name": "Interfaces / Types",
      "scope": ["entity.name.type.interface", "support.type", "entity.name.type.alias"],
      "settings": { "foreground": "#6EB8E8" }
    },
    {
      "name": "Generics / Type parameters",
      "scope": "entity.name.type.parameter",
      "settings": { "foreground": "#6EB8E8", "fontStyle": "italic" }
    },
    {
      "name": "Enums",
      "scope": "entity.name.type.enum",
      "settings": { "foreground": "#E8834A" }
    },
    {
      "name": "Enum members",
      "scope": "variable.other.enummember",
      "settings": { "foreground": "#F0C040" }
    },
    {
      "name": "Decorators / Annotations",
      "scope": ["meta.decorator", "entity.name.function.decorator"],
      "settings": { "foreground": "#B880F0", "fontStyle": "bold" }
    },
    {
      "name": "Namespace / Module",
      "scope": "entity.name.type.namespace",
      "settings": { "foreground": "#7A9AB8" }
    },
    {
      "name": "Properties / Members",
      "scope": ["variable.other.property", "meta.object-literal.key"],
      "settings": { "foreground": "#5096CC" }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": { "foreground": "#56B88A" }
    },
    {
      "name": "Template literals",
      "scope": "string.template",
      "settings": { "foreground": "#56B88A" }
    },
    {
      "name": "Template interpolation ${}",
      "scope": ["meta.template.expression", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#00D8C0" }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "settings": { "foreground": "#F0C040" }
    },
    {
      "name": "Booleans / null / undefined",
      "scope": "constant.language",
      "settings": { "foreground": "#E8844A" }
    },
    {
      "name": "Regex",
      "scope": "string.regexp",
      "settings": { "foreground": "#F09040" }
    },
    {
      "name": "HTML / JSX tags",
      "scope": ["entity.name.tag", "entity.name.tag.html", "entity.name.tag.jsx", "entity.name.tag.tsx"],
      "settings": { "foreground": "#E06C7A" }
    },
    {
      "name": "HTML attributes",
      "scope": "entity.other.attribute-name",
      "settings": { "foreground": "#29B6A8" }
    },
    {
      "name": "CSS property names",
      "scope": "support.type.property-name.css",
      "settings": { "foreground": "#5096CC" }
    },
    {
      "name": "CSS values / units",
      "scope": ["support.constant.property-value.css", "constant.other.unit.css"],
      "settings": { "foreground": "#F0C040" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading.1", "markup.heading.2", "markup.heading.3", "markup.heading"],
      "settings": { "foreground": "#6EB8E8", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "settings": { "foreground": "#C4DFF0", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "settings": { "foreground": "#90C4DC", "fontStyle": "italic" }
    },
    {
      "name": "Markdown inline code",
      "scope": "markup.raw.inline",
      "settings": { "foreground": "#F0C040" }
    },
    {
      "name": "Markdown blockquote",
      "scope": "markup.quote",
      "settings": { "foreground": "#3A7A8A", "fontStyle": "italic" }
    },
    {
      "name": "Markdown link text",
      "scope": "string.other.link.title.markdown",
      "settings": { "foreground": "#5096CC" }
    },
    {
      "name": "Markdown link URL",
      "scope": "markup.underline.link",
      "settings": { "foreground": "#6EB8E8", "fontStyle": "italic" }
    },
    {
      "name": "SQL keywords",
      "scope": "keyword.other.sql",
      "settings": { "foreground": "#E06C7A", "fontStyle": "bold" }
    },
    {
      "name": "SQL functions",
      "scope": "support.function.sql",
      "settings": { "foreground": "#29B6A8" }
    }
  ],
  "semanticTokenColors": {
    "variable": "#C4DFF0",
    "variable.constant": "#F0C040",
    "variable.defaultLibrary": "#6EB8E8",
    "parameter": "#90C4DC",
    "property": "#5096CC",
    "function": "#29B6A8",
    "method": "#29B6A8",
    "class": "#E8834A",
    "interface": "#6EB8E8",
    "enum": "#E8834A",
    "enumMember": "#F0C040",
    "type": "#6EB8E8",
    "typeParameter": "#6EB8E8",
    "namespace": "#7A9AB8",
    "decorator": "#B880F0",
    "comment": "#3A7A8A",
    "string": "#56B88A",
    "number": "#F0C040",
    "keyword": "#E06C7A",
    "operator": "#8AB0CC",
    "macro": "#B880F0",
    "regexp": "#F09040"
  }
}
