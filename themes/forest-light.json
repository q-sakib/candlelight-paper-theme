  "tokenColors": [
    {
      "name": "Comments — doc",
      "scope": "comment.block.documentation",
      "settings": { "foreground": "#3A7848", "fontStyle": "italic" }
    },
    {
      "name": "Comments",
      "scope": "comment",
      "settings": { "foreground": "#3A6840", "fontStyle": "italic" }
    },
    {
      "name": "Keywords",
      "scope": "keyword",
      "settings": { "foreground": "#A01838", "fontStyle": "bold" }
    },
    {
      "name": "Control flow",
      "scope": "keyword.control",
      "settings": { "foreground": "#901030", "fontStyle": "bold" }
    },
    {
      "name": "Import / Export",
      "scope": ["keyword.control.import", "keyword.control.export"],
      "settings": { "foreground": "#904A18" }
    },
    {
      "name": "Storage type",
      "scope": "storage.type",
      "settings": { "foreground": "#904A18" }
    },
    {
      "name": "Storage modifier",
      "scope": "storage.modifier",
      "settings": { "foreground": "#904A18", "fontStyle": "italic" }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": { "foreground": "#2A5038" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other.readwrite"],
      "settings": { "foreground": "#162010" }
    },
    {
      "name": "Constants",
      "scope": "variable.other.constant",
      "settings": { "foreground": "#7A5808" }
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter",
      "settings": { "foreground": "#2A5038" }
    },
    {
      "name": "this / self",
      "scope": "variable.language",
      "settings": { "foreground": "#904A18", "fontStyle": "italic" }
    },
    {
      "name": "Function definitions",
      "scope": "entity.name.function",
      "settings": { "foreground": "#107838" }
    },
    {
      "name": "Function calls",
      "scope": "meta.function-call",
      "settings": { "foreground": "#107838" }
    },
    {
      "name": "Arrow =>",
      "scope": "storage.type.function.arrow",
      "settings": { "foreground": "#107838" }
    },
    {
      "name": "Built-in functions",
      "scope": "support.function",
      "settings": { "foreground": "#107838" }
    },
    {
      "name": "Classes",
      "scope": ["entity.name.type.class", "support.class"],
      "settings": { "foreground": "#804A10" }
    },
    {
      "name": "Interfaces / Types",
      "scope": ["entity.name.type.interface", "support.type", "entity.name.type.alias"],
      "settings": { "foreground": "#0A5878" }
    },
    {
      "name": "Generics",
      "scope": "entity.name.type.parameter",
      "settings": { "foreground": "#0A5878", "fontStyle": "italic" }
    },
    {
      "name": "Enums",
      "scope": "entity.name.type.enum",
      "settings": { "foreground": "#804A10" }
    },
    {
      "name": "Enum members",
      "scope": "variable.other.enummember",
      "settings": { "foreground": "#7A5808" }
    },
    {
      "name": "Decorators",
      "scope": ["meta.decorator", "entity.name.function.decorator"],
      "settings": { "foreground": "#901870", "fontStyle": "bold" }
    },
    {
      "name": "Namespace",
      "scope": "entity.name.type.namespace",
      "settings": { "foreground": "#2A5838" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "meta.object-literal.key"],
      "settings": { "foreground": "#0A6858" }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": { "foreground": "#386818" }
    },
    {
      "name": "Template interpolation",
      "scope": ["meta.template.expression", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#107838" }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "settings": { "foreground": "#7A5808" }
    },
    {
      "name": "Booleans / null",
      "scope": "constant.language",
      "settings": { "foreground": "#8A6010" }
    },
    {
      "name": "Regex",
      "scope": "string.regexp",
      "settings": { "foreground": "#8A6010" }
    },
    {
      "name": "HTML / JSX tags",
      "scope": ["entity.name.tag", "entity.name.tag.html"],
      "settings": { "foreground": "#A01838" }
    },
    {
      "name": "HTML attributes",
      "scope": "entity.other.attribute-name",
      "settings": { "foreground": "#107838" }
    },
    {
      "name": "CSS property names",
      "scope": "support.type.property-name.css",
      "settings": { "foreground": "#0A6858" }
    },
    {
      "name": "Markdown headings",
      "scope": "markup.heading",
      "settings": { "foreground": "#0A5878", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "settings": { "foreground": "#162010", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "settings": { "foreground": "#2A5038", "fontStyle": "italic" }
    },
    {
      "name": "Markdown inline code",
      "scope": "markup.raw.inline",
      "settings": { "foreground": "#7A5808" }
    },
    {
      "name": "SQL keywords",
      "scope": "keyword.other.sql",
      "settings": { "foreground": "#A01838", "fontStyle": "bold" }
    }
  ],
  "semanticTokenColors": {
    "variable": "#162010",
    "variable.constant": "#7A5808",
    "variable.defaultLibrary": "#0A5878",
    "parameter": "#2A5038",
    "property": "#0A6858",
    "function": "#107838",
    "method": "#107838",
    "class": "#804A10",
    "interface": "#0A5878",
    "enum": "#804A10",
    "enumMember": "#7A5808",
    "type": "#0A5878",
    "namespace": "#2A5838",
    "decorator": "#901870",
    "string": "#386818",
    "number": "#7A5808",
    "keyword": "#A01838",
    "operator": "#2A5038"
  }
}
