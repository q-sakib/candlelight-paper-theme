{
  "name": "Candlelight Galaxy Light",
  "type": "light",
  "colors": {
    "editor.background": "#FAF3E0", // Paper / Light Nebula
    "editor.foreground": "#2D2A26", // Charcoal text
    "editorLineNumber.foreground": "#A4C3B2", // Faint moon glow
    "editorCursor.foreground": "#EB5E28", // Mars / Asteroid heat
    "editor.selectionBackground": "#F4E28560", // Candle flame
    "editor.inactiveSelectionBackground": "#F4E28530",
    "editor.lineHighlightBackground": "#F5CB5C33",
    "editorIndentGuide.background": "#E8DAB5",
    "editorIndentGuide.activeBackground": "#F4A259",
    "editorBracketMatch.background": "#BC4B5133", // Cosmic match
    "editorBracketMatch.border": "#BC4B51",
    "activityBar.background": "#274C77", // Space horizon
    "activityBar.foreground": "#F4E285",
    "activityBarBadge.background": "#F4A259",
    "activityBarBadge.foreground": "#FAF3E0",
    "sideBar.background": "#FFF8E1",
    "sideBar.foreground": "#403D39",
    "sideBarSectionHeader.background": "#A3CEF1",
    "statusBar.background": "#6096BA", // Deep sky blue
    "statusBar.foreground": "#FAF3E0",
    "statusBar.debuggingBackground": "#BC4B51",
    "titleBar.activeBackground": "#F5CB5C",
    "titleBar.inactiveBackground": "#F4E285",
    "titleBar.activeForeground": "#2D2A26",
    "titleBar.inactiveForeground": "#6B9080",
    "tab.activeBackground": "#F5CB5C",
    "tab.inactiveBackground": "#F4E285",
    "tab.activeForeground": "#403D39",
    "tab.inactiveForeground": "#6B9080",
    "tab.border": "#FAF3E0",
    "panel.background": "#FFF8E1",
    "panel.border": "#E6D9C0",
    "terminal.background": "#FAF3E0",
    "terminal.foreground": "#403D39"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": "comment",
      "settings": {
        "foreground": "#6B9080", // Moon Dust
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": "keyword",
      "settings": {
        "foreground": "#BC4B51", // Nebula flare
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": {
        "foreground": "#8CB369" // Comet trail
      }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#EE6055" // Meteor spark
      }
    },
    {
      "name": "Variables",
      "scope": "variable",
      "settings": {
        "foreground": "#403D39" // Deep matter
      }
    },
    {
      "name": "Functions",
      "scope": "support.function, entity.name.function, meta.function-call",
      "settings": {
        "foreground": "#5B8E7D" // Saturn rings
      }
    },
    {
      "name": "Arrow Functions",
      "scope": "storage.type.function.arrow",
      "settings": {
        "foreground": "#1DD3B0" // Plasma jet
      }
    },
    {
      "name": "Callback Functions",
      "scope": "meta.function-call.arguments",
      "settings": {
        "foreground": "#086375" // Subspace logic
      }
    },
    {
      "name": "Classes",
      "scope": "entity.name.type.class, support.class",
      "settings": {
        "foreground": "#F4A259" // Orbital ring
      }
    },
    {
      "name": "Objects",
      "scope": "meta.object-literal.key",
      "settings": {
        "foreground": "#B2967D" // Dust cluster
      }
    },
    {
      "name": "Arrays",
      "scope": "meta.array",
      "settings": {
        "foreground": "#A4C3B2" // Stellar data
      }
    },
    {
      "name": "Constants",
      "scope": "constant.language, constant.character",
      "settings": {
        "foreground": "#EB5E28" // Core pulse
      }
    },
    {
      "name": "Interfaces",
      "scope": "entity.name.type.interface",
      "settings": {
        "foreground": "#F5CB5C" // Interface orbit
      }
    },
    {
      "name": "Properties",
      "scope": "variable.other.property",
      "settings": {
        "foreground": "#6096BA" // System node
      }
    },
    {
      "name": "This Keyword",
      "scope": "variable.language.this",
      "settings": {
        "foreground": "#A3CEF1", // Blue nova
        "fontStyle": "italic"
      }
    }
  ]
}