  "tokenColors": [
    {
      "name": "Comments — doc",
      "scope": "comment.block.documentation",
      "settings": { "foreground": "#9A8050", "fontStyle": "italic" }
    },
    {
      "name": "Comments",
      "scope": "comment",
      "settings": { "foreground": "#7A6838", "fontStyle": "italic" }
    },
    {
      "name": "Keywords",
      "scope": "keyword",
      "settings": { "foreground": "#C03010", "fontStyle": "bold" }
    },
    {
      "name": "Control flow",
      "scope": "keyword.control",
      "settings": { "foreground": "#B02808", "fontStyle": "bold" }
    },
    {
      "name": "Import / Export",
      "scope": ["keyword.control.import", "keyword.control.export"],
      "settings": { "foreground": "#A06010" }
    },
    {
      "name": "Storage type",
      "scope": "storage.type",
      "settings": { "foreground": "#A06010" }
    },
    {
      "name": "Storage modifier",
      "scope": "storage.modifier",
      "settings": { "foreground": "#A06010", "fontStyle": "italic" }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": { "foreground": "#6A5030" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other.readwrite"],
      "settings": { "foreground": "#281C08" }
    },
    {
      "name": "Constants",
      "scope": "variable.other.constant",
      "settings": { "foreground": "#906808" }
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter",
      "settings": { "foreground": "#6A5030" }
    },
    {
      "name": "this / self",
      "scope": "variable.language",
      "settings": { "foreground": "#A06010", "fontStyle": "italic" }
    },
    {
      "name": "Function definitions",
      "scope": "entity.name.function",
      "settings": { "foreground": "#107850" }
    },
    {
      "name": "Function calls",
      "scope": "meta.function-call",
      "settings": { "foreground": "#107850" }
    },
    {
      "name": "Arrow =>",
      "scope": "storage.type.function.arrow",
      "settings": { "foreground": "#107850" }
    },
    {
      "name": "Built-in functions",
      "scope": "support.function",
      "settings": { "foreground": "#107850" }
    },
    {
      "name": "Classes",
      "scope": ["entity.name.type.class", "support.class"],
      "settings": { "foreground": "#904A18" }
    },
    {
      "name": "Interfaces / Types",
      "scope": ["entity.name.type.interface", "support.type", "entity.name.type.alias"],
      "settings": { "foreground": "#0A5890" }
    },
    {
      "name": "Generics",
      "scope": "entity.name.type.parameter",
      "settings": { "foreground": "#0A5890", "fontStyle": "italic" }
    },
    {
      "name": "Enums",
      "scope": "entity.name.type.enum",
      "settings": { "foreground": "#904A18" }
    },
    {
      "name": "Enum members",
      "scope": "variable.other.enummember",
      "settings": { "foreground": "#906808" }
    },
    {
      "name": "Decorators",
      "scope": ["meta.decorator", "entity.name.function.decorator"],
      "settings": { "foreground": "#681890", "fontStyle": "bold" }
    },
    {
      "name": "Namespace",
      "scope": "entity.name.type.namespace",
      "settings": { "foreground": "#6A5830" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "meta.object-literal.key"],
      "settings": { "foreground": "#0A4880" }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": { "foreground": "#406010" }
    },
    {
      "name": "Template interpolation",
      "scope": ["meta.template.expression", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#107850" }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "settings": { "foreground": "#906808" }
    },
    {
      "name": "Booleans / null",
      "scope": "constant.language",
      "settings": { "foreground": "#805808" }
    },
    {
      "name": "Regex",
      "scope": "string.regexp",
      "settings": { "foreground": "#805808" }
    },
    {
      "name": "HTML / JSX tags",
      "scope": ["entity.name.tag", "entity.name.tag.html"],
      "settings": { "foreground": "#C03010" }
    },
    {
      "name": "HTML attributes",
      "scope": "entity.other.attribute-name",
      "settings": { "foreground": "#107850" }
    },
    {
      "name": "CSS property names",
      "scope": "support.type.property-name.css",
      "settings": { "foreground": "#0A4880" }
    },
    {
      "name": "Markdown headings",
      "scope": "markup.heading",
      "settings": { "foreground": "#0A5890", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "settings": { "foreground": "#281C08", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "settings": { "foreground": "#6A5030", "fontStyle": "italic" }
    },
    {
      "name": "Markdown inline code",
      "scope": "markup.raw.inline",
      "settings": { "foreground": "#906808" }
    },
    {
      "name": "SQL keywords",
      "scope": "keyword.other.sql",
      "settings": { "foreground": "#C03010", "fontStyle": "bold" }
    }
  ],
  "semanticTokenColors": {
    "variable": "#281C08",
    "variable.constant": "#906808",
    "variable.defaultLibrary": "#0A5890",
    "parameter": "#6A5030",
    "property": "#0A4880",
    "function": "#107850",
    "method": "#107850",
    "class": "#904A18",
    "interface": "#0A5890",
    "enum": "#904A18",
    "enumMember": "#906808",
    "type": "#0A5890",
    "namespace": "#6A5830",
    "decorator": "#681890",
    "string": "#406010",
    "number": "#906808",
    "keyword": "#C03010",
    "operator": "#6A5030"
  }
}
