{
  "name": "candlelight-paper-theme",
  "displayName": "Candlelight Paper Theme",
  "description": "12 nature-inspired VS Code themes — Candlelight, Galaxy, Ocean, Mountain, Forest, Desert. Eye-friendly palettes for long coding sessions.",
  "version": "1.1.1",
  "publisher": "SharkB",
  "icon": "media/preview.png",
  "galleryBanner": {
    "color": "#1C1A19",
    "theme": "dark"
  },
  "keywords": [
    "theme",
    "color-theme",
    "dark",
    "light",
    "nature",
    "candlelight",
    "ocean",
    "forest",
    "desert",
    "mountain"
  ],
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "activationEvents": [
    "onCommand:theme.switchToCandlelightLight",
    "onCommand:theme.switchToCandlelightDark"
  ],
  "main": "./extension.js",
  "contributes": {
    "themes": [
      {
        "label": "Candlelight Paper Light",
        "uiTheme": "vs",
        "path": "./themes/candlelight-paper-light.json"
      },
      {
        "label": "Candlelight Paper Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/candlelight-paper-dark.json"
      },
      {
        "label": "Candlelight Galaxy Light",
        "uiTheme": "vs",
        "path": "./themes/candlelight-galaxy-light.json"
      },
      {
        "label": "Candlelight Galaxy Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/candlelight-galaxy-dark.json"
      },
      {
        "label": "Ocean Light",
        "uiTheme": "vs",
        "path": "./themes/ocean-light.json"
      },
      {
        "label": "Ocean Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/ocean-dark.json"
      },
      {
        "label": "Mountain Light",
        "uiTheme": "vs",
        "path": "./themes/mountain-light.json"
      },
      {
        "label": "Mountain Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/mountain-dark.json"
      },
      {
        "label": "Forest Light",
        "uiTheme": "vs",
        "path": "./themes/forest-light.json"
      },
      {
        "label": "Forest Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/forest-dark.json"
      },
      {
        "label": "Desert Light",
        "uiTheme": "vs",
        "path": "./themes/desert-light.json"
      },
      {
        "label": "Desert Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/desert-dark.json"
      }
    ],
    "commands": [
      {
        "command": "theme.switchToCandlelightLight",
        "title": "Switch to Candlelight Paper Light"
      },
      {
        "command": "theme.switchToCandlelightDark",
        "title": "Switch to Candlelight Paper Dark"
      }
    ],
    "configuration": {
      "title": "Candlelight Theme Settings",
      "properties": {
        "candlelightTheme.opacity": {
          "type": "number",
          "default": 0.08,
          "description": "Set background image opacity (used with custom CSS)"
        },
        "candlelightTheme.enableGlow": {
          "type": "boolean",
          "default": false,
          "description": "Enable subtle glow effect for active elements"
        }
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/q-sakib/candlelight-paper-theme"
  }
}